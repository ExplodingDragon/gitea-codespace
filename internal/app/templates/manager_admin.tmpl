<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Codespace Manager administration</title>
  <style>
    body { margin: 0; color: #24292f; background: #f6f8fa; font: 14px system-ui, sans-serif; }
    main { width: min(960px, calc(100% - 32px)); margin: 40px auto; }
    h1 { font-size: 24px; }
    section { margin: 20px 0; padding: 20px; border: 1px solid #d0d7de; border-radius: 6px; background: #fff; }
    form { display: grid; grid-template-columns: 2fr 1fr 2fr auto auto; gap: 12px; align-items: end; }
    label { display: grid; gap: 6px; font-weight: 600; }
    input, textarea, button { box-sizing: border-box; min-height: 34px; padding: 6px 10px; border: 1px solid #8c959f; border-radius: 6px; background: #fff; }
    button { cursor: pointer; font-weight: 600; }
    .primary { color: #fff; border-color: #1f883d; background: #1f883d; }
    .danger { color: #cf222e; }
    .notice { padding: 12px; border-radius: 6px; background: #dafbe1; }
    .error { padding: 12px; border-radius: 6px; color: #cf222e; background: #ffebe9; }
    .hint { color: #57606a; font-weight: 400; }
    .config { grid-template-columns: 1fr; }
    textarea { width: 100%; font: 13px ui-monospace, monospace; }
    @media (max-width: 760px) { form { grid-template-columns: 1fr; } }
  </style>
</head>
<body><main>
  <h1>Codespace Manager administration</h1>
  <p>Site changes take effect after the Manager process restarts. Secrets are accepted for verification and encrypted storage, and are never displayed again. Keep this HTTP administration page on loopback or behind a TLS reverse proxy, and use HTTPS for remote Gitea sites.</p>
  {{if .Message}}<p class="notice">{{.Message}}</p>{{end}}
  {{if .Error}}<p class="error">{{.Error}}</p>{{end}}
  <section>
    <h2>Runtime configuration</h2>
    <form class="config" method="post" action="/config">
      <label>Configuration<textarea required name="config" rows="24">{{.Config}}</textarea></label>
      <button class="primary" type="submit">Save configuration</button>
    </form>
  </section>
  <section>
    <h2>Add site</h2>
    <form method="post" action="/sites">
      <label>Gitea URL<input required name="gitea_url" type="url" placeholder="https://gitea.example.com"></label>
      <label>Manager ID<input required name="manager_id" type="number" min="1"></label>
      <label>Manager secret<input required name="manager_secret" type="password" autocomplete="new-password"></label>
      <label><span>Enabled</span><input name="enabled" type="checkbox"></label>
      <button class="primary" type="submit">Save</button>
    </form>
  </section>
  {{range .Sites}}
  <section>
    <form method="post" action="/sites">
      <input name="id" type="hidden" value="{{.ID}}">
      <label>Gitea URL<input required name="gitea_url" type="url" value="{{.GiteaURL}}"></label>
      <label>Manager ID<input required name="manager_id" type="number" min="1" value="{{.ManagerID}}"></label>
      <label>Manager secret <span class="hint">Leave empty to keep it</span><input name="manager_secret" type="password" autocomplete="new-password"></label>
      <label><span>Enabled</span><input name="enabled" type="checkbox" {{if .Enabled}}checked{{end}}></label>
      <button class="primary" type="submit">Save</button>
    </form>
    <form method="post" action="/sites/{{.ID}}/verify"><button type="submit">Verify</button></form>
    <form method="post" action="/sites/{{.ID}}/delete" onsubmit="return confirm('Delete this site identity?');"><button class="danger" type="submit">Delete</button></form>
  </section>
  {{end}}
</main></body>
</html>
