# USB/IP and hotplug device nodes in the Kata guest.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USBIP_CORE=y
CONFIG_USBIP_VHCI_HCD=y

# Storage, partitions and common removable-media filesystems.
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_NTFS3_FS=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# Serial consoles and common USB-UART adapters.
CONFIG_USB_ACM=y
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_FTDI_SIO=y
CONFIG_USB_SERIAL_CP210X=y
CONFIG_USB_SERIAL_CH341=y
CONFIG_USB_SERIAL_PL2303=y

# HID debug probes and selected I2C/SPI/GPIO bridges.
CONFIG_INPUT=y
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_HIDRAW=y
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_GPIOLIB=y
CONFIG_GPIO_CDEV=y
CONFIG_HID_CP2112=y
CONFIG_HID_MCP2200=y
CONFIG_HID_MCP2221=y
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_SPI_CH341=y
CONFIG_SPI_SPIDEV=y

# USB test and measurement instruments.
CONFIG_USB_TMC=y

# Keep USB device imports separate from the Pod's network configuration.
CONFIG_USB_NET_DRIVERS=n
CONFIG_CAN=n
