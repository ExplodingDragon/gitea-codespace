set -eu
root=${CODESPACE_WEB_IDE_PROGRAM_DIR:?}
cd "${CODESPACE_WEB_IDE_WORKSPACE:?}"
diagnostics=$(mktemp "${TMPDIR:-/tmp}/yepanywhere-output.XXXXXX")
trap 'rm -f "$diagnostics"' EXIT

child=
stop() {
  if [ -n "$child" ]; then
    kill -s "$1" "$child" 2>/dev/null || :
    wait "$child" || :
  fi
  exit 0
}
trap 'stop HUP' HUP
trap 'stop INT' INT
trap 'stop TERM' TERM

while :; do
  : >"$diagnostics"
  "$root/program/node/bin/node" "$root/lib/capture-output.mjs" "$diagnostics" &
  child=$!
  status=0
  wait "$child" || status=$?
  child=

  message="Yep Anywhere exited with code $status"
  if [ -s "$diagnostics" ]; then
    message=$(cat "$diagnostics")
  fi
  : >"$diagnostics"
  gitea-codespace-event webide.error "$message" &
  child=$!
  wait "$child" || printf 'Report Yep Anywhere exit event failed\n' >&2
  child=

  sleep 1 &
  child=$!
  wait "$child" || :
  child=
done
