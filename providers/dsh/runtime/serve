set -eu
root=${CODESPACE_WEB_IDE_PROGRAM_DIR:?}
data=${CODESPACE_WEB_IDE_DATA_DIR:?}
address=${CODESPACE_WEB_IDE_ADDRESS:?}
workspace=${CODESPACE_WEB_IDE_WORKSPACE:?}
host=${address%:*}
port=${address##*:}
[ -d "$workspace" ] || {
  printf 'DeepSeek Harness workspace is not a directory: %s\n' "$workspace" >&2
  exit 1
}
cd "$workspace"
export DSH_HOME=$data

child=
stopping=
stop() {
  stopping=$1
  [ -z "$child" ] || kill -s "$1" "$child" 2>/dev/null || :
}
trap 'stop HUP' HUP
trap 'stop INT' INT
trap 'stop TERM' TERM

while :; do
  "$root/program/bin/dsh" web --patch "$root/lib/codespace.patch.yml" \
    --workspace "$workspace" --trusted-proxy --no-open --host "$host" --port "$port" &
  child=$!
  wait "$child" || :
  child=
  [ -z "$stopping" ] || exit 0
  sleep 1 &
  child=$!
  wait "$child" || :
  child=
  [ -z "$stopping" ] || exit 0
done
