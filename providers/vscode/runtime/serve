set -eu
root=${CODESPACE_WEB_IDE_PROGRAM_DIR:?}
data=${CODESPACE_WEB_IDE_DATA_DIR:?}
address=${CODESPACE_WEB_IDE_ADDRESS:?}
workspace=${CODESPACE_WEB_IDE_WORKSPACE:?}
exec "$root/program/bin/code-server" \
  --bind-addr "$address" \
  --auth none \
  --disable-telemetry \
  --disable-update-check \
  --user-data-dir "$data/user-data" \
  --extensions-dir "$data/extensions" \
  "$workspace"
