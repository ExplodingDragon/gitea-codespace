{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["replicaCount", "image", "identity", "admin", "gatewayAPI", "serviceAccount", "networkPolicy"],
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 1},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest", "pullPolicy", "pullSecrets"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]},
        "pullSecrets": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clusterIssuer"],
      "properties": {"clusterIssuer": {"type": "string", "minLength": 1}}
    },
    "admin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publicURL", "tokenSecret", "service", "ingress"],
      "properties": {
        "publicURL": {"type": "string", "pattern": "^https?://"},
        "tokenSecret": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "key"],
          "properties": {"name": {"type": "string", "minLength": 1}, "key": {"type": "string", "minLength": 1}}
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "port", "annotations"],
          "properties": {
            "type": {"type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "annotations": {"type": "object", "additionalProperties": {"type": "string"}}
          }
        },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "className", "host", "tlsSecret", "annotations"],
          "properties": {
            "enabled": {"type": "boolean"},
            "className": {"type": "string"},
            "host": {"type": "string"},
            "tlsSecret": {"type": "string"},
            "annotations": {"type": "object", "additionalProperties": {"type": "string"}}
          }
        }
      }
    },
    "gatewayAPI": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parent"],
      "properties": {
        "parent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "namespace", "httpListener", "sshListener"],
          "properties": {
            "name": {"type": "string"},
            "namespace": {"type": "string"},
            "httpListener": {"type": "string"},
            "sshListener": {"type": "string"}
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["annotations"],
      "properties": {"annotations": {"type": "object", "additionalProperties": {"type": "string"}}}
    },
    "podAnnotations": {"type": "object", "additionalProperties": {"type": "string"}},
    "podLabels": {"type": "object", "additionalProperties": {"type": "string"}},
    "nodeSelector": {"type": "object", "additionalProperties": {"type": "string"}},
    "tolerations": {"type": "array"},
    "affinity": {"type": "object"},
    "topologySpreadConstraints": {"type": "array"},
    "resources": {"type": "object"},
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "adminIngressCIDRs"],
      "properties": {
        "enabled": {"type": "boolean"},
        "adminIngressCIDRs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    }
  }
}
